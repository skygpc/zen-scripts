}


function _sky_trv() {
    if (_sB && get_val(PS4_SQUARE) && !vibrator_triggered) {
        if (!square_held) {
            square_held = 1;
            square_hold_start_time = current_time;

        } else {
            if ((current_time - square_hold_start_time) >= _sBMs) {
                combo_run(_sky_rvc);
                vibrator_triggered = 1;
            }
        }
    } else if (!get_val(PS4_SQUARE)) {
        square_held = 0;
        vibrator_triggered = 0;
    }
}


function _sky_hmd() {
    if (_s7 && get_val(PS4_L1)) {
        if (!meterDunkButtonHeld) {
            meterDunkButtonHeld = 1;
            meterDunkStartTime = current_time;
        }
        

        if (!meterDunkComboRunning) {
            if (_s8e) {
                combo_stop(_sky_FS1);
                combo_stop(_sky_FS2);
                combo_stop(_sky_FS3);
                combo_stop(_sky_FS4);
                combo_stop(_sky_c01);
                combo_stop(_sky_c03);
                combo_stop(_sky_c05);
                combo_stop(_sky_c02);
                combo_stop(_sky_c04);
                combo_stop(_sky_c06);
                combo_stop(_sky_c07);
                combo_stop(_sky_c09);
                combo_stop(_sky_c11);
                combo_stop(_sky_c08);
                combo_stop(_sky_c10);
                combo_stop(_sky_c12);
            }

            combo_run(_sky_mdc);
            meterDunkComboRunning = 1;
            meterDunkOverrideActive = 1;
        }
    } else {
        if (meterDunkButtonHeld) {
            meterDunkButtonHeld = 0;
            if (meterDunkComboRunning) {
                combo_stop(_sky_mdc);
                meterDunkComboRunning = 0;
                meterDunkOverrideActive = 0;
                set_val(PS4_RY, 0);
                set_val(PS4_R2, 0);
            }
        }
    }
    
    if (meterDunkComboRunning && (current_time - meterDunkStartTime) >= meterDunkDuration) {

        combo_stop(_sky_mdc);
        meterDunkComboRunning = 0;
        meterDunkOverrideActive = 0;
        set_val(PS4_RY, 0);
        set_val(PS4_R2, 0);
    }
    
    _s7LastState = _s7;
}


function _sky_hds() {
    if (_s8e && !meterDunkOverrideActive) {
        if (_s8 == 1) {
            if (get_val(dribble_up_btn)) {
                set_val(dribble_up_btn, 0);
                combo_run(_sky_FS1);
            } else combo_stop(_sky_FS1);

            if (get_val(dribble_right_btn)) {

                set_val(dribble_right_btn, 0);
                combo_run(_sky_FS2);
            } else combo_stop(_sky_FS2);

            if (get_val(dribble_down_btn)) {
                set_val(dribble_down_btn, 0);
                combo_run(_sky_FS3);
            } else combo_stop(_sky_FS3);

            if (get_val(dribble_left_btn)) {
                set_val(dribble_left_btn, 0);
                combo_run(_sky_FS4);
            } else combo_stop(_sky_FS4);
        }
        else if (_s8 == 2) {
            if (get_val(dribble_up_btn)) {
                set_val(dribble_up_btn, 0);
                if (_S7x0 == 1) combo_run(_sky_c01);
                else if (_S7x0 == 2) combo_run(_sky_c03);

                else if (_S7x0 == 3) combo_run(_sky_c05);
            } else {
                combo_stop(_sky_c01);
                combo_stop(_sky_c03);
                combo_stop(_sky_c05);
            }
            
            if (get_val(dribble_down_btn)) {
                set_val(dribble_down_btn, 0);
                if (_S7x1 == 1) combo_run(_sky_c02);
                else if (_S7x1 == 2) combo_run(_sky_c04);
                else if (_S7x1 == 3) combo_run(_sky_c06);
            } else {
                combo_stop(_sky_c02);
                combo_stop(_sky_c04);
                combo_stop(_sky_c06);
            }
            
            if (get_val(dribble_left_btn)) {

                set_val(dribble_left_btn, 0);
                if (_S7x2 == 1) combo_run(_sky_c07);
                else if (_S7x2 == 2) combo_run(_sky_c09);
                else if (_S7x2 == 3) combo_run(_sky_c11);
            } else {
                combo_stop(_sky_c07);
                combo_stop(_sky_c09);
                combo_stop(_sky_c11);
            }
            
            if (get_val(dribble_right_btn)) {
                set_val(dribble_right_btn, 0);
