            }

            if (get_val(PS4_R2)
                && (abs(get_val(PS4_LY)) > 50 || abs(get_val(PS4_LX)) > 50
                || get_val(PS4_LY) < -50       || get_val(PS4_LX) < -50)) {
                tFade = 1;
            } else {
                tFade = 0;
            }

            if (!_aQ && !tFade) {
                if (get_val(PS4_SQUARE)) {

                    if (!_sqB) {
                        _sqB = 1;
                    }
                    set_val(PS4_RY, 100);
                    set_val(PS4_RX, random5);
                    set_val(PS4_SQUARE, 0);
                    set_val(PS4_R2, 0);
                } else {
                    if (_sqB) {
