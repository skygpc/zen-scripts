                    rect_oled(30, 40, 68, 10, 1, OLED_WHITE);
                    print(34, 41, OLED_FONT_SMALL, OLED_BLACK, _sky_GV[0]);
                }
                _sky_bp = _sky_bt * 118 / 5000;
                if (_sky_bp > 118) _sky_bp = 118;
                rect_oled(5, 57, _sky_bp, 2, 1, OLED_WHITE);
                line_oled(5, 56, 123, 56, 1, OLED_WHITE);
                line_oled(5, 60, 123, 60, 1, OLED_WHITE);
                if (_sky_bt >= 5000) { _sky_boot = 4; _sky_bt = 0; }
            } else {
                if (_sky_mxt > 0) {
                    _sky_mxt = _sky_mxt - get_rtime();
                    _sky_dpx();
                } else {
                if (_sD >= 7) _sky_aoc();
                print(center_x(16, OLED_FONT_SMALL_WIDTH), 2, OLED_FONT_SMALL, OLED_WHITE, _sky_FUT[0]);
                _sky_bp = _sky_bp + get_rtime();
                if (_sky_bp >= 5000) { _sky_bp = 0; }
                if (_sky_bp < 2500) {
                    print(center_x(8, OLED_FONT_MEDIUM_WIDTH), 22, OLED_FONT_MEDIUM, OLED_WHITE, _sky_S3[0]);
                } else {
                    print(center_x(5, OLED_FONT_MEDIUM_WIDTH), 22, OLED_FONT_MEDIUM, OLED_WHITE, _sky_S2[0]);
                }
                print(center_x(15, OLED_FONT_SMALL_WIDTH), 42, OLED_FONT_SMALL, OLED_WHITE, _sky_SCR[0]);
                _sky_plx = _sky_plx + 1;
                if (_sky_plx > 127) _sky_plx = 0;
                pixel_oled(_sky_plx, 56, 1);
                pixel_oled(127 - _sky_plx, 58, 1);
                pixel_oled((_sky_plx + 64) % 128, 57, 1);
            }}
        }

        _sky_hfdp(); _sky_hspt(); _sky_hlrc(); _sky_hpso(); _sky_hala();
        _sky_ait();
        _sky_trv();
        
        _sky_hds();

        if (_s4 && _s6) {
