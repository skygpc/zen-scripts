function _sky_hfdp() {
    if (_sky_fdp > 0 && !_mE) {
        if (get_val(PS4_L1) && event_press(PS4_SQUARE)) {
            set_val(PS4_SQUARE, 0);
            _sky_fdh = 1;
            if (_sky_fdp == 1) { combo_run(_sky_cfd1); }
            else if (_sky_fdp == 2) { combo_run(_sky_cfd2); }
            else if (_sky_fdp == 3) { combo_run(_sky_cfd3); }
        }
        if (_sky_fdh && !get_val(PS4_L1)) { _sky_fdh = 0; }
        if (_sky_fdh) {
            _sky_fdt = _sky_fdt + get_rtime();
            if (_sky_fdt > 800) {
                set_val(PS4_L2, 80 + random(-5, 5));
            }
        } else { _sky_fdt = 0; }
    }
}

function _sky_hspt() {
    if (_sky_spt && !_mE && get_val(PS4_CROSS)) {
        combo_run(_sky_cspt);
    }
}

function _sky_hlrc() {
    if (_sky_lrc > 0 && !_mE) {
        if (_sky_lrc == 1 && abs(get_val(PS4_LX)) > 70) {
            if ((get_val(PS4_LX) > 0 && last_movement_x < -30) || (get_val(PS4_LX) < 0 && last_movement_x > 30)) {
                set_val(PS4_LX, 0); set_val(PS4_LY, 0);
            }
        } else if (_sky_lrc == 2 && get_val(PS4_L1) && abs(get_val(PS4_LX)) > 50) {
            set_val(PS4_LX, 0); set_val(PS4_LY, 0);
        }
        last_movement_x = get_val(PS4_LX);
    }
}

function _sky_hpso() {
    if (_sky_pso > 0 && !_mE && get_val(PS4_R2) > 20) {
        if (_sky_pso == 1 && get_val(PS4_L2) > 20) {
            set_val(PS4_RY, -100 + random(-3, 3)); set_val(PS4_RX, random(-5, 5));
        } else if (_sky_pso == 2 && event_press(PS4_SQUARE) && abs(get_val(PS4_LY)) > 40) {
            combo_run(_sky_cfl);
        } else if (_sky_pso == 3 && event_press(PS4_SQUARE) && abs(get_val(PS4_LX)) > 50) {
            combo_run(_sky_ceu);
        }
    }
}

