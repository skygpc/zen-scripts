                        set_val(PS4_RX, 0);
                        combo_run(_sky_ruc);
                    }
                    set_val(PS4_SQUARE, 0);
                }
            }
            else if (!_aQ && tFade) {
                if (get_val(PS4_SQUARE)) {

                    if (!_sqB) {
                        _sqB = 1;
                    }
                    set_val(PS4_RY, -100);
                    set_val(PS4_RX, random5);
