                        _sqB = 1;
                        flicked = 0;
                        rs_down_active = 0;
                    }

                    if (!flicked) {
                        if (get_val(PS4_LX) < -50 || get_val(PS4_LY) < -50) {
                            combo_run(_sky_rrf);
                        } else if (get_val(PS4_LX) > 50 || get_val(PS4_LY) > 50) {
                            combo_run(_sky_rlf);
                        }

                        flicked = 1;
                        combo_run(_sky_wf);
                        set_val(PS4_LX, 0);
                        set_val(PS4_LY, 0);
                        set_val(PS4_R2, 0);
                    } else if (rs_down_active == 1 || (!flicked && rs_down_active == 0)) {
                        set_val(PS4_SQUARE, 100);
                    }

                    set_val(PS4_LX, 0);
                    set_val(PS4_LY, 0);
                    set_val(PS4_R2, 0);
                } else {
                    if (_sqB) {
                        _sqB = 0;
                        rs_down_active = 0;
                    }
                    set_val(PS4_SQUARE, 0);
                }

            }
        }

        if (_s0) {
            if (get_val(PS4_R1) > 18) {
                set_val(PS4_SQUARE, get_val(PS4_SQUARE));
