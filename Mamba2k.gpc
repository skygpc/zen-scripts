            } else {
                if (_sqB) {
                    _sqB = 0;
                    rs_down_active = 0;
                }
                set_val(PS4_SQUARE, 0);
            }
        }
        
        _rmT = FALSE;

        if (!_s2 && _s0 && get_val(PS4_L3)) {
            _rmT = TRUE;
            set_val(PS4_R3, 0);

            set_val(PS4_RY, 0);
