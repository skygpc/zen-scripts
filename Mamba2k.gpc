            set_val(PS4_RY, 0);
        }

        if (!_sqB) {
            set_val(PS4_RY, get_val(PS4_RY));
        }

        if (_sH) {
            if (get_val(PS4_L2) > 20 && get_val(PS4_R1) > 20) {
                set_val(PS4_R1, 0);
