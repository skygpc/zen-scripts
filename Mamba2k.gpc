init {

    _sky_lpv();
    for (e8_i = 0; e8_i < e8_stars; e8_i++) {
        e8_star_x[e8_i] = random(0, 127);
        e8_star_y[e8_i] = random(0, 63);
        e8_star_speed[e8_i] = random(1, 3);
        e8_star_dx[e8_i] = random(-1, 1);
        e8_star_dy[e8_i] = random(0, 1);
        if (e8_star_dx[e8_i] == 0 && e8_star_dy[e8_i] == 0) e8_star_dy[e8_i] = 1;
    }
    _sky_pi = 0;
    while (_sky_pi < 8) {
        _sky_px[_sky_pi] = random(5, 122);
        _sky_py[_sky_pi] = random(50, 63);
        _sky_pdy[_sky_pi] = -1;
        _sky_pi = _sky_pi + 1;
    }

    _sky_aoc();
    vm_tctrl(-2);
}


main {
    if(get_val(XB1_XBOX) && (get_val(XB1_LT))) {
        Script = FALSE;
        set_rgb(0, 0, 0);
    }

    if(get_val(XB1_XBOX) && (get_val(XB1_RT))) {
        Script = TRUE;
        _sky_aoc();
    }

    if (Script) {
        current_time += get_rtime();
        _sky_usf();


        _sky_hmd();
        
        if (!meterDunkOverrideActive) {
            combo_run(_sky_MC);
        }

        if (was__mE && !_mE) {
            cls_oled(0);
            _sky_mxt = 1500;
        }
        was__mE = _mE;

        if (get_val(MOD_MENU_TOGGLE_HOLD) && event_press(MOD_MENU_TOGGLE_PRESS) && !_sky_msp) {
            if (_mE) {
                checkB = 1;
                _mE = 0;
                custom_dribble_menu = 0;
                combo_run(_sky_von);
                cls_oled(0);
                _sky_aoc();
                _sky_mxt = 1500;
            } else {
                _sky_msp = 1;
                _sky_mst = 0;
                combo_run(_sky_vof);
                cls_oled(0);
                _sky_aoc();
            }
        }

        if (_sky_msp) {
            _sky_mst = _sky_mst + get_rtime();
            cls_oled(0);
            _sky_dpx();
            _sky_bp = _sky_mst * 118 / 3000;
            if (_sky_bp > 118) _sky_bp = 118;
            rect_oled(5, 55, _sky_bp, 2, 1, OLED_WHITE);
            line_oled(5, 54, 123, 54, 1, OLED_WHITE);
            line_oled(5, 58, 123, 58, 1, OLED_WHITE);
            e8_i = 3 - _sky_mst * 3 / 3000;
            if (e8_i < 0) e8_i = 0;
            if (e8_i > 3) e8_i = 3;
            print(112, 43, OLED_FONT_SMALL, OLED_WHITE, _sky_CD[e8_i]);
            if (_sky_mst >= 3000) {
                _sky_msp = 0;
                _mE = 1;
                checkB = 1;
                custom_dribble_menu = 0;
            }
            set_val(PS4_SQUARE, 0); set_val(PS4_CROSS, 0); set_val(PS4_CIRCLE, 0); set_val(PS4_TRIANGLE, 0);
            set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_RX, 0); set_val(PS4_RY, 0);
        } else if (custom_dribble_menu) {
            cls_oled(0);

            rect_oled(0, 0, 128, 12, 1, OLED_WHITE);
            print(3, 2, OLED_FONT_SMALL, OLED_BLACK, dribble_custom_header[custom_dribble_page]);

            if (custom_dribble_page == 0) {
                option_width = _sky_sl(dribble_up_names[_S7x0]) * OLED_FONT_MEDIUM_WIDTH;

                _sky_dun(_S7x0);
            } else if (custom_dribble_page == 1) {
                option_width = _sky_sl(dribble_down_names[_S7x1]) * OLED_FONT_MEDIUM_WIDTH;
                _sky_ddn(_S7x1);
            } else if (custom_dribble_page == 2) {
                option_width = _sky_sl(dribble_lr_names[_S7x2]) * OLED_FONT_MEDIUM_WIDTH;
                _sky_dln(_S7x2);
            } else if (custom_dribble_page == 3) {
                option_width = _sky_sl(dribble_lr_names[_S7x3]) * OLED_FONT_MEDIUM_WIDTH;
                _sky_dln(_S7x3);
            }
            
            line_oled(0, 54, 127, 54, 1, OLED_WHITE);
            line_oled(4, 59, 8, 56, 1, OLED_WHITE); line_oled(4, 59, 8, 62, 1, OLED_WHITE);
            line_oled(123, 59, 119, 56, 1, OLED_WHITE); line_oled(123, 59, 119, 62, 1, OLED_WHITE);
            
            if(custom_dribble_page > custom_dribble_pages){ custom_dribble_page = custom_dribble_pages; }
            if(custom_dribble_page < 0){ custom_dribble_page = 0; }

            if(get_val(MOD_MENU_TOGGLE_HOLD)) {

                set_val(MOD_INCREASE, 0);
                set_val(MOD_DECREASE, 0);
                set_val(MOD_PREVIOUS, 0);
                set_val(MOD_NEXT, 0);
            }

            if(event_press(MOD_NEXT)) {
                custom_dribble_page++;
                combo_run(_sky_vvc);
            }

            if(event_press(MOD_PREVIOUS)) {
                custom_dribble_page--;
                combo_run(_sky_vvc);
            }

            if (custom_dribble_page == 0) {
                if (event_press(MOD_INCREASE)) { 
                    _S7x0 = (_S7x0 + 3) % 4; 

                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_17, _S7x0);
                }
                if (event_press(MOD_DECREASE)) { 
                    _S7x0 = (_S7x0 + 1) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_17, _S7x0);
                }
            }

            if (custom_dribble_page == 1) {
                if (event_press(MOD_INCREASE)) { 
                    _S7x1 = (_S7x1 + 3) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_18, _S7x1);
                }

                if (event_press(MOD_DECREASE)) { 
                    _S7x1 = (_S7x1 + 1) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_18, _S7x1);
                }
            }

            if (custom_dribble_page == 2) {
                if (event_press(MOD_INCREASE)) { 
                    _S7x2 = (_S7x2 + 3) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_19, _S7x2);
                }
                if (event_press(MOD_DECREASE)) { 
                    _S7x2 = (_S7x2 + 1) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();

                    set_pvar(SPVAR_19, _S7x2);
                }
            }

            if (custom_dribble_page == 3) {
                if (event_press(MOD_INCREASE)) { 
                    _S7x3 = (_S7x3 + 3) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_20, _S7x3);
                }
                if (event_press(MOD_DECREASE)) { 
                    _S7x3 = (_S7x3 + 1) % 4; 
                    combo_run(_sky_vvc);
                    UPDATE__s8e();
                    set_pvar(SPVAR_20, _S7x3);
                }
            }


            if (event_press(PS4_CIRCLE)) {
                custom_dribble_menu = 0;
                combo_run(_sky_vof);
                UPDATE__s8e();
            }

            set_val(MOD_INCREASE, 0);
            set_val(MOD_DECREASE, 0);
            set_val(MOD_PREVIOUS, 0);
            set_val(MOD_NEXT, 0);
            _sky_dmp();
        }
        else if (_mE) {
            cls_oled(0);

            rect_oled(0, 0, 128, 12, 1, OLED_WHITE);
            if (!isXbox) {
                print(3, 2, OLED_FONT_SMALL, OLED_BLACK, menu_header[page]);
            } else {
                print(3, 2, OLED_FONT_SMALL, OLED_BLACK, menu_headerX[page]);
            }
            rect_oled(0, 14, 128, 38, 1, OLED_WHITE);
            rect_oled(1, 15, 126, 36, 1, OLED_BLACK);

            if (page == 0) {
                option_width = _sky_sl(shot_visual_cues[_sE]) * OLED_FONT_MEDIUM_WIDTH;
                print(center_x(_sky_sl(shot_visual_cues[_sE]), OLED_FONT_MEDIUM_WIDTH), 28, OLED_FONT_MEDIUM, OLED_WHITE, shot_visual_cues[_sE]);
            } else if (page == 7) {
                option_width = _sky_sl(onOff[_sF]) * OLED_FONT_MEDIUM_WIDTH;
                print(center_x(_sky_sl(onOff[_sF]), OLED_FONT_MEDIUM_WIDTH), 28, OLED_FONT_MEDIUM, OLED_WHITE, onOff[_sF]);
            } else if (page == 8) {
                option_width = _sky_sl(_aQ_options[_mS]) * OLED_FONT_MEDIUM_WIDTH;

                print(center_x(_sky_sl(_aQ_options[_mS]), OLED_FONT_MEDIUM_WIDTH), 28, OLED_FONT_MEDIUM, OLED_WHITE, _aQ_options[_mS]);
            } else if (page == 9) {
