                        combo_run(_sky_rlf);
                    }
                    flicked = 1;
                    combo_run(_sky_wf);
                    set_val(PS4_LX, 0);
                    set_val(PS4_LY, 0);
                    set_val(PS4_R2, 0);
                } else if (rs_down_active == 1 || (!flicked && rs_down_active == 0)) {
