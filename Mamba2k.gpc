                    }
                    set_val(PS4_SQUARE, 0);

                }
            }
        }

        if (_s3) {
            if (get_val(PS4_L2) < 5) {
                if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                    if (!isHolding) {
                        isHolding = 1;
                        holdTimer = 0;
                       if (get_val(PS4_RY) < 0) {
                            rs_is_up = 1;
                        } else {
                            rs_is_up = 0;
                        }
                    }
                    holdTimer += get_rtime();
                } else {
                    if (isHolding) {

                        if (holdTimer > 300) {
                            if (rs_is_up) {
                                combo_run(_sky_rdc);
                            } else {
                                combo_run(_sky_ruc);
                            }
                            }
                        isHolding = 0;
                        holdTimer = 0;
                    }
                }
            }
        }

        if (_aQ && !_s0 && get_val(PS4_L2) <= 0) {
