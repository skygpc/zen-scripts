function _sky_usf() {
    _sky_stt = _sky_stt + get_rtime();
    if (_sky_stt < 80) return;
    _sky_stt = 0;
    for (e8_i = 0; e8_i < e8_stars; e8_i++) {
        e8_star_x[e8_i] = e8_star_x[e8_i] + e8_star_dx[e8_i];
        e8_star_y[e8_i] = e8_star_y[e8_i] + e8_star_dy[e8_i];
        if (e8_star_x[e8_i] > 127 || e8_star_x[e8_i] < 0 || e8_star_y[e8_i] > 63 || e8_star_y[e8_i] < 0) {
            e8_star_x[e8_i] = random(20, 107);
            e8_star_y[e8_i] = random(15, 48);
            e8_star_dx[e8_i] = random(-1, 1);
            e8_star_dy[e8_i] = random(0, 1);
            if (e8_star_dx[e8_i] == 0 && e8_star_dy[e8_i] == 0) e8_star_dy[e8_i] = 1;
            e8_star_speed[e8_i] = random(1, 2);
        }
    }
}


function _sky_dsf() {
    for (e8_i = 0; e8_i < e8_stars; e8_i++) {
        line_oled(e8_star_x[e8_i], e8_star_y[e8_i], e8_star_x[e8_i] - e8_star_dx[e8_i], e8_star_y[e8_i] - e8_star_dy[e8_i], 1, OLED_WHITE);
    }
}


function _sky_dmp() {
    _sky_pht = _sky_pht + get_rtime();
    if (_sky_pht < 2500) {
        _sky_php = 0;
    } else if (_sky_pht < 4000) {
        _sky_php = 1;
    } else if (_sky_pht < 5500) {
        _sky_php = 2;
    } else {
        _sky_pht = 0; _sky_php = 0;
    }
    _sky_pi = 0;
    while (_sky_pi < 8) {
        pixel_oled(_sky_px[_sky_pi], _sky_py[_sky_pi], 1);
        if (_sky_py[_sky_pi] > 1) pixel_oled(_sky_px[_sky_pi], _sky_py[_sky_pi] + 1, 1);
        if (_sky_php == 0) {
            _sky_py[_sky_pi] = _sky_py[_sky_pi] - 1;
        } else if (_sky_php == 1) {
            _sky_py[_sky_pi] = _sky_py[_sky_pi] - 2;
        } else {
            _sky_py[_sky_pi] = _sky_py[_sky_pi] + 3;
        }
        if (_sky_py[_sky_pi] < 0 || _sky_py[_sky_pi] > 63) {
            _sky_px[_sky_pi] = random(5, 122);
            _sky_py[_sky_pi] = random(56, 63);
        }
        _sky_pi = _sky_pi + 1;
    }
}

